{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/plugins/marketplaces/agent-foundation/plugins/core/scripts/hook_run.py\"; [ -f \"$f\" ] || f=; python3 ${f:+\"$f\"} \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/plugins/marketplaces/agent-foundation/plugins/core/scripts/hook_run.py\"; [ -f \"$f\" ] || f=; python3 ${f:+\"$f\"} \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" post"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/plugins/marketplaces/agent-foundation/plugins/core/scripts/hook_run.py\"; [ -f \"$f\" ] || f=; python3 ${f:+\"$f\"} \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" start"
          }
        ]
      }
    ]
  }
}
